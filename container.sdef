Bootstrap: docker
From: docker.papenmeier.io/bencher:latest
Namespace:
Stage: build

# An Apptainer/Singularity definition for the benchmark server, bootstrapped
# from the published Docker image so both runtimes ship the same bytes.
#
# Adapt this for your own optimizer: bootstrap from gaunab/bencher:latest, clone
# your repository in %post, and point %runscript at your entry point. The server
# itself needs nothing beyond what the base image provides -- %startscript below
# is the whole of it.

%environment
    export LANG=C.UTF-8

%post
    # Nothing to install. This used to clone the bencherclient repository and
    # install Poetry so the image carried its own test harness; the end-to-end
    # suite lives in the bencher repository now (tests/e2e), driven over gRPC
    # from outside the container, so the image no longer needs either.
    #
    :

%startscript
    /opt/bencher/BencherServer/.venv/bin/python /entrypoint.py

%runscript
    echo "Container was created"
    echo "Arguments received: $*"
    exec "$@"
